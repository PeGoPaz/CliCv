{
  "name": "portfolio-terminal",
  "version": "1.0.0",
  "description": "Interactive terminal-style developer portfolio",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "npx http-server . -p 3000 -c-1",
    "og": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --disable-gpu --hide-scrollbars --force-device-scale-factor=1 --screenshot=assets/og.png --window-size=1200,630 assets/og.html",
    "check:cv-sync": "node scripts/check-cv-sync.mjs",
    "dev": "npm run build && npm run serve"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}